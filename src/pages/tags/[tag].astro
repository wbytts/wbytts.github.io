---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const tags = new Set(notes.flatMap((note) => note.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      notes: notes
        .filter((note) => note.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, notes } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的全部笔记`}>
  <h1>标签：{tag}</h1>
  <ul style="list-style:none;padding:0;">
    {
      notes.map((note) => (
        <li style="padding:0.7rem 0;border-bottom:1px solid var(--border);">
          <time datetime={note.data.pubDate.toISOString()}>
            {note.data.pubDate.toISOString().slice(0, 10)}
          </time>
          <h2 style="margin:0.15rem 0;font-size:1.1rem;">
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          </h2>
        </li>
      ))
    }
  </ul>
  <p><a href="/tags/">← 全部标签</a></p>
</BaseLayout>
