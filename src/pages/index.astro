---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}
---

<BaseLayout title="首页" description="个人笔记与随笔">
  <h1>全部笔记</h1>
  {
    notes.length === 0 ? (
      <p>还没有笔记，去 <code>src/content/notes/</code> 写一篇吧。</p>
    ) : (
      <ul style="list-style:none;padding:0;">
        {notes.map((note) => (
          <li style="padding:0.9rem 0;border-bottom:1px solid var(--border);">
            <time datetime={note.data.pubDate.toISOString()}>
              {formatDate(note.data.pubDate)}
            </time>
            <h2 style="margin:0.15rem 0 0.3rem;font-size:1.2rem;">
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            </h2>
            {note.data.description && (
              <p style="margin:0 0 0.4rem;color:var(--muted);">
                {note.data.description}
              </p>
            )}
            {note.data.tags.length > 0 && (
              <p style="margin:0;display:flex;gap:0.4rem;flex-wrap:wrap;">
                {note.data.tags.map((tag) => (
                  <a class="tag" href={`/tags/${tag}/`}>
                    {tag}
                  </a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
